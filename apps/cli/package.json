{
  "name": "style-capture",
  "version": "0.0.3",
  "description": "Capture computed CSS and HTML from web pages, map to Tailwind utilities",
  "keywords": [
    "ai",
    "claude",
    "css",
    "html",
    "style-capture",
    "tailwind"
  ],
  "homepage": "https://github.com/mblode/style-capture/tree/main/apps/cli",
  "bugs": {
    "url": "https://github.com/mblode/style-capture/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mblode/style-capture.git",
    "directory": "apps/cli"
  },
  "bin": {
    "style-capture": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "start": "node dist/cli.js",
    "check-types": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "npm run lint && npm run format:check && npm run check-types && npm run test",
    "fix": "npm run format && npm run lint:fix"
  },
  "dependencies": {
    "@clack/prompts": "^1.1.0",
    "clipboardy": "^4.0.0",
    "commander": "^14.0.3",
    "playwright": "^1.52.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.5",
    "@style-capture/core": "*",
    "@types/node": "^24.12.0",
    "lefthook": "^2.1.4",
    "oxfmt": "^0.40.0",
    "oxlint": "^1.55.0",
    "tsdown": "^0.12.0",
    "typescript": "~5.9.3",
    "ultracite": "^7.3.0",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
