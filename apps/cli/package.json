{
  "name": "style-capture",
  "version": "1.2.0",
  "description": "Capture computed CSS from any web page and map to Tailwind. Structured context for AI coding agents",
  "keywords": [
    "ai",
    "claude",
    "css",
    "html",
    "style-capture",
    "tailwind"
  ],
  "homepage": "https://github.com/mblode/style-capture/tree/main/apps/cli",
  "bugs": {
    "url": "https://github.com/mblode/style-capture/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mblode/style-capture.git",
    "directory": "apps/cli"
  },
  "bin": {
    "style-capture": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "start": "node dist/cli.js",
    "check-types": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "npm run lint && npm run format:check && npm run check-types && npm run test",
    "fix": "npm run format && npm run lint:fix"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "clipboardy": "^5.3.1",
    "commander": "^15.0.0",
    "playwright": "^1.61.1"
  },
  "devDependencies": {
    "@style-capture/core": "*",
    "@types/node": "^26.1.1",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "tsdown": "^0.22.5",
    "typescript": "7.0.2",
    "ultracite": "7.9.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  }
}
