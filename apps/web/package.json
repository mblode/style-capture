{
  "name": "@style-capture/web",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "dev": "portless style-capture npx next dev",
    "build": "node scripts/build-well-known-skills.mjs && next build",
    "start": "next start",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check-types": "tsc --noEmit",
    "check": "npm run lint && npm run format:check && npm run check-types",
    "fix": "npm run format && npm run lint:fix"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@style-capture/core": "*",
    "@tailwindcss/typography": "^0.5.20",
    "blode-icons-react": "^0.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.7.2",
    "griffo": "^1.1.1",
    "motion": "^12.42.2",
    "next": "^16.2.10",
    "posthog-js": "^1.407.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "shadcn": "^4.13.0",
    "shiki": "^4.3.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "babel-plugin-react-compiler": "1.0.0",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "tailwindcss": "^4",
    "typescript": "6.0.3",
    "ultracite": "7.9.3"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "1.1.5",
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.2",
    "lightningcss-linux-x64-gnu": "1.32.0"
  }
}
