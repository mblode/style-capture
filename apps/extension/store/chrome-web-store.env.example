# Chrome Web Store credentials for scripts/chrome-web-store-publish.mjs

# OAuth refresh token flow
CWS_CLIENT_ID=""
CWS_CLIENT_SECRET=""
CWS_REFRESH_TOKEN=""

# Existing extension item ID after first create/upload
CWS_EXTENSION_ID=""

# Optional for V2 existing-item endpoints
CWS_PUBLISHER_ID=""

# Optional service-account flow for V2 existing-item endpoints
CWS_SERVICE_ACCOUNT_EMAIL=""
CWS_SERVICE_ACCOUNT_PRIVATE_KEY=""
