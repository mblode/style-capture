{
  "name": "@style-capture/extension",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "eval:format": "node --import tsx evals/format-eval.ts",
    "store:publish": "node scripts/chrome-web-store-publish.mjs",
    "store:render": "node --import tsx scripts/render-store-assets.ts",
    "store:screenshots": "node --import tsx scripts/chrome-web-store-screenshots.ts",
    "check-types": "tsc -b --pretty false",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run format:check && npm run check-types && npm run test",
    "fix": "npm run format && npm run lint:fix"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@style-capture/core": "*",
    "blode-icons-react": "^0.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/chrome": "^0.2.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "playwright-core": "^1.61.1",
    "postcss": "^8.5.17",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "ultracite": "7.9.3",
    "vite": "^8.1.4",
    "vite-plugin-zip-pack": "^1.2.4",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24"
  }
}
