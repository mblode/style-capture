{
  "name": "@style-capture/extension",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "eval:format": "node --import tsx evals/format-eval.ts",
    "store:publish": "node scripts/chrome-web-store-publish.mjs",
    "store:render": "node --import tsx scripts/render-store-assets.ts",
    "store:screenshots": "node --import tsx scripts/chrome-web-store-screenshots.ts",
    "check-types": "tsc -b --pretty false",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run format:check && npm run check-types && npm run test",
    "fix": "npm run format && npm run lint:fix"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@style-capture/core": "*",
    "blode-icons-react": "^0.3.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "shadcn": "^4.0.5",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.5",
    "@crxjs/vite-plugin": "^2.3.0",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/chrome": "^0.1.37",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^27.0.1",
    "lefthook": "^2.1.4",
    "oxfmt": "^0.40.0",
    "oxlint": "^1.55.0",
    "playwright-core": "^1.58.2",
    "postcss": "^8.5.6",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "ultracite": "^7.3.0",
    "vite": "^8.0.0",
    "vite-plugin-zip-pack": "^1.2.4",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
