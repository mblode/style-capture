{
  "name": "style-capture",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "format": "turbo format",
    "format:check": "turbo format:check",
    "check-types": "turbo check-types",
    "test": "turbo test",
    "check": "npm run lint && npm run format:check && npm run check-types && npm run test",
    "fix": "npm run format && npm run lint:fix",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "turbo build && changeset publish",
    "prepare": "if [ -z \"$VERCEL\" ]; then lefthook install; fi"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "portless": "^0.15.4",
    "turbo": "^2",
    "typescript": "6.0.3",
    "ultracite": "7.9.3"
  },
  "overrides": {
    "rolldown-plugin-dts": {
      "typescript": "$typescript"
    },
    "tsdown": {
      "typescript": "$typescript"
    }
  },
  "packageManager": "npm@12.0.1"
}
